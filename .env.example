# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais envoyé sur GitHub (voir .gitignore).

# --- Notifications Telegram (recommandé) ---
# Token du bot, donné par @BotFather
TELEGRAM_BOT_TOKEN=
# ID Telegram du destinataire (via @userinfobot).
# Plusieurs destinataires possibles, séparés par des virgules : 111111111,222222222
TELEGRAM_CHAT_ID=

# --- Notifications WhatsApp via CallMeBot (optionnel) ---
CALLMEBOT_PHONE=+2126XXXXXXXX
CALLMEBOT_APIKEY=

# --- Numéro WhatsApp affiché aux clientes (bouton vert) ---
# Format international sans "+" ni 0 : 2126XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
